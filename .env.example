# Copy to .env.local and fill in. Never commit .env.local.

# ── Cloudinary ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_FOLDER=storefront
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=storefront

# ── Supabase (this store's own project) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Postgres URI (Settings → Database → Connection string, session pooler) — used by db:* scripts only
SUPABASE_DB_URL=

# Emails that become admins on sign-up / sign-in (comma-separated)
ADMIN_EMAILS=

# Public origin for canonical URLs, sitemap.xml and structured data (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Back-office owner login (/admin-login). Works with or without Supabase.
# ADMIN_PASSWORD_HASH: run  "your password" | npm run -s admin:hash  (PowerShell) and paste the output.
# ADMIN_SESSION_SECRET: 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_LOGIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
