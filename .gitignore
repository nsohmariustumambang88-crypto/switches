# Only source code is tracked. Secrets, build output, dependencies and
# media assets (served from Cloudinary) stay out of git.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# env files — real values live only in .env.local; .env.example is the template
.env*
!.env.example
# exported env files (e.g. switch.env for Vercel's "Import .env") hold real secrets too
*.env

# secrets
*.pem
*.key

# media assets — catalog images live in Cloudinary (storefront/catalog/…);
# keep a local copy in public/catalog only to re-run `npm run cloudinary:upload`
/public/catalog/

# design tooling output (review screenshots, mocks, local config)
/.impeccable/

# editor / OS / sync clutter
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
